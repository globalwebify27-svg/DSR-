datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Report {
  id              String   @id @default(cuid())
  firmName        String
  ownerName       String
  mobileNumber    String
  outletType      String   // "Retail", "Wholesale", "Distributor", "Supermarket", "Pharmacy", "Other"
  interestLevel   String   // "Interested", "Not Interested", "Maybe"
  status          String   @default("Pending") // "Pending", "In Progress", "Completed"
  quotePrice      Float?
  followUpDate    String?  // YYYY-MM-DD
  followUpTime    String?  // HH:MM
  standeeType     String?  @default("None") // "None", "Standard Roll-up", "Luxury Teardrop", "Acrylic Display", "Counter Stand"
  followUpRemarks String?
  feedback        String?
  outletImage     String?
  latitude        Float?
  longitude       Float?
  locationAddress String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([interestLevel])
  @@index([status])
  @@index([followUpDate])
}
